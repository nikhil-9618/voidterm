# ─────────────────────────────────────────────────────────────
# VOIDTERM environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Supabase or Neon connection string). Add ?sslmode=require for hosted DBs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voidterm?schema=public"
# Direct (non-pooled) URL used by Prisma migrations. Can equal DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/voidterm?schema=public"

# Minimum 32 characters. Openssl rand -base64 48
JWT_SECRET=""

# Public origin of the deployment (used for metadata / links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (Resend) ───────────────────────────────────────────
# When unset in development, OTP codes are printed to the server console instead.
RESEND_API_KEY=""
# Must be a verified sender/domain in Resend.
EMAIL_FROM="VOIDTERM <noreply@example.com>"

# ── AI providers ─────────────────────────────────────────────
OPENAI_API_KEY=""
# OpenRouter free models: no credit card required.
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
# Optional local runtime. Defaults to http://localhost:11434
OLLAMA_URL=""

# ── Rate limiting (Upstash Redis) ────────────────────────────
# Recommended in production for global sliding-window limits. If unset in
# production, the app uses the Postgres RateLimitBucket table (shared across
# instances); development uses an in-process limiter.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Attachments (optional) ───────────────────────────────────
# Supabase Storage REST upload, or a dev-only local fallback under public/uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="attachments"
